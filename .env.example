# ─────────────────────────────────────────────────────────────
# Percepta — variables de entorno (copiar a .env)
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# PostgreSQL + TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=percepta
POSTGRES_USER=percepta
POSTGRES_PASSWORD=percepta_dev_pw
DATABASE_URL=postgresql://percepta:percepta_dev_pw@localhost:5432/percepta

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://percepta:percepta_dev_pw@localhost:5672
RABBITMQ_MGMT_URL=http://localhost:15672

# MinIO / S3 (evidencias)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=percepta
S3_SECRET_KEY=percepta_dev_pw
S3_BUCKET_EVIDENCES=percepta-evidences

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Puertos de servicios (dev)
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=3001
TENANT_SERVICE_PORT=3002
DEVICE_SERVICE_PORT=3003
EVENT_SERVICE_PORT=3004
RULES_ENGINE_PORT=3005

# ai-worker (Python)
AI_WORKER_DEVICE=cpu            # cpu | cuda:0
AI_MODULES_PATH=./modules
