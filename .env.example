# ─────────────────────────────────────────────────────────────
# Percepta — variables de entorno (copiar a .env)
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# PostgreSQL + TimescaleDB
# 127.0.0.1 y no localhost: Node lo resuelve a ::1 (IPv6) y Docker publica en IPv4.
POSTGRES_HOST=127.0.0.1
# Puerto en el HOST (5432 suele estar tomado por un PostgreSQL nativo de Windows)
POSTGRES_HOST_PORT=5433
POSTGRES_PORT=5433
POSTGRES_DB=percepta
POSTGRES_USER=percepta
POSTGRES_PASSWORD=percepta_dev_pw
# Servicios: rol de aplicación SIN bypass de RLS (defensa en profundidad)
DATABASE_URL=postgresql://percepta_app:percepta_app_dev_pw@127.0.0.1:5433/percepta
# Migraciones/operación: superusuario
DATABASE_URL_ADMIN=postgresql://percepta:percepta_dev_pw@127.0.0.1:5433/percepta

# Redis
REDIS_URL=redis://127.0.0.1:6379

# RabbitMQ
RABBITMQ_URL=amqp://percepta:percepta_dev_pw@127.0.0.1:5672
RABBITMQ_MGMT_URL=http://127.0.0.1:15672

# MinIO / S3 (evidencias)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=percepta
S3_SECRET_KEY=percepta_dev_pw
S3_BUCKET_EVIDENCES=percepta-evidences

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# 8 h en desarrollo: un token dura toda la sesión de trabajo.
# En producción vuelve a minutos (lo emite identity-service con refresh).
JWT_ACCESS_TTL=28800
JWT_REFRESH_TTL=1209600

# Puertos de servicios (dev)
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=3001
TENANT_SERVICE_PORT=3002
DEVICE_SERVICE_PORT=3003
EVENT_SERVICE_PORT=3004
RULES_ENGINE_PORT=3005

# ai-worker (Python)
AI_WORKER_DEVICE=cpu            # cpu | cuda:0
AI_MODULES_PATH=./modules
