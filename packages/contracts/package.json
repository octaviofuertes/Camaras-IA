{
  "name": "@percepta/contracts",
  "version": "1.0.0",
  "description": "Contratos canónicos compartidos de Percepta (tipos TS, .proto, JSON Schemas). Fuente: docs/CONTRACTS.md",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "proto", "schemas"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated --ts_proto_opt=esModuleInterop=true -I proto proto/percepta/detections/v1/detections.proto",
    "lint": "echo 'lint contracts'"
  },
  "devDependencies": {
    "ts-proto": "^2.0.3",
    "typescript": "^5.4.5"
  }
}
